#!/system/bin/sh

scripts_dir="${0%/*}"
source /data/adb/box/settings.ini

PROPFILE="/data/adb/modules/box_for_root/module.prop"

find_packages_uid() {
  log Info "Прокси: ${proxy_mode}"

  if [ "${proxy_mode}" = "core" ]; then
    log Info "Режим ядра включён; пропуск обработки package и GID"
    > "${uid_list}"
    return 0
  fi

  log Info "Начало обработки списка UID/GID"
  log Debug "Список приложений (из package.list.cfg): ${packages_list[*]}"
  log Debug "Список GID (из gid.list.cfg): ${gid_list[*]}"

  > "${uid_list}"

  local packages_file
  packages_file="${system_packages_file:-/data/system/packages.list}"
  for entry in "${packages_list[@]}"; do
    local prefix="0"
    local package="${entry}"

    case "${entry}" in
      *:*)
        prefix="${entry%%:*}"
        package="${entry#*:}"
        ;;
    esac

    case "${prefix}" in
      ''|*[!0-9]*)
        log Warning "Ошибка: пользователь \"${prefix}\" приложение: \"${package}\" -> неверный префикс пользователя, откат к 0"
        prefix="0"
        ;;
    esac

    if [ -z "${package}" ] || [ "${package}" = "${entry}" ] && [ "${entry}" = "${prefix}" ]; then
      log Warning "Ошибка: пользователь \"${prefix}\" приложение: \"${entry}\" -> неверное имя пакета"
      continue
    fi

    local base_uid
    base_uid=$(busybox awk -v pkg="${package}" '$1 == pkg {print $2; exit}' "${packages_file}" 2>/dev/null)

    case "${base_uid}" in
      ''|*[!0-9]*)
        log Warning "Ошибка: пользователь \"${prefix}\" приложение: \"${package}\" -> не найдено"
        continue
        ;;
    esac

    local multiuser_uid=$((base_uid + prefix * 100000))
    echo "${multiuser_uid}" >> "${uid_list}"
    log Info "Успех: пользователь \"${prefix}\" приложение: \"${package}\" -> ${multiuser_uid}"
  done

  if [ ${#gid_list[@]} -gt 0 ]; then
    printf "%s\n" "${gid_list[@]}" >> "${uid_list}"
    log Info "Success: GID: ${gid_list[*]} -> добавлено"
  fi

  if [ -s "${uid_list}" ]; then
    local temp_uid_list="${box_run_state}/temp_uid.list"
    busybox sort -un "${uid_list}" > "${temp_uid_list}"
    mv "${temp_uid_list}" "${uid_list}"
  fi
}

log_service_results() {
    local core_name="$1"
    local proxy_mode_type="$2"
    local uids="$3"

    log Info "Операция: обновление списка UID для TUN-режима"
    log Info "Режим: ${proxy_mode_type}"

    if [ "${proxy_mode_type}" = "core" ]; then
        log Debug "(Режим ядра, прозрачный прокси для всех приложений)"
    elif [ -n "$uids" ]; then
        log Debug "Применённые UID: ${uids}"
    else
        log Debug "(Нет)"
    fi
}

box_check_logs() {
  # Удалить все логи ядра и создать резервную копию
  log Info "Удалить и создать резервную копию файлов логов"
  (
    for bin in "${bin_list[@]}"; do
      if [ -f "${box_run}/${bin}.log" ]; then
        mv "${box_run}/${bin}.log" "${box_run}/${bin}.old.log"
      fi
    done
    # Удалить другие файлы логов
    find "${box_run}" -maxdepth 1 -type f \( -name "root" -o -name "*.inotify.log" \) -exec rm -f {} +
    find "${box_run_state}" -maxdepth 1 -type f \( -name "*.list" -a ! -name "appuid.list" \) -exec rm -f {} +
    # Удалить логи старше одного дня
    find "${box_run}" -maxdepth 1 -type f \( -name "*.log" -o -name "*.old.log" \) -mtime +1 -exec rm -f {} +
  ) &
}

box_bin_alive() {
  local PID=$(<"${box_pid}" 2>/dev/null)
  if ! kill -0 "$PID" >/dev/null 2>&1; then
    log Error "$(<"${box_run}/${bin_name}.log")"
    log Error "${bin_name} служба не запущена."
    log Error "Проверьте ${bin_name}.log для получения подробностей."
    log Error "Очистка устаревшего pid $PID"
    for bin in "${bin_list[@]}"; do
      killall -15 "${bin}" >/dev/null || busybox pkill -15 "${bin}" >/dev/null 2>&1 
    done
    "${scripts_dir}/box.iptables" disable >/dev/null 2>&1
    [ -f "${box_pid}" ] && rm -f "${box_pid}"
    exit 1
  else
    return 0
  fi
}

box_run_crontab() {
  pkill -f "busybox crond" >/dev/null 2>&1
  busybox crontab -c "${box_run_state}" -r
  echo "# Задачи cron для root" > "${box_run_state}/root"

  if [ "${run_crontab}" = "true" ]; then
    log Debug "crond включён"
    if [ "$update_subscription" = "true" ] || [ "$update_geo" = "true" ]; then
      log Debug "Интервал задач cron: ${interva_update}."
      echo "${interva_update} ${scripts_dir}/box.tool geosub" >> "${box_run_state}/root"
      log Info "${bin_name} обновление geox: ${update_geo}."
      if [ "${bin_name}" = "mihomo" ]; then
        log Info "${bin_name} обновление подписки: ${update_subscription}."
      fi
    fi
    cat "${box_dir}/crontab.cfg" >> "${box_run_state}/root"
    chmod 0644 "${box_run_state}/root"
    nohup busybox crond -c "${box_run_state}" >/dev/null 2>&1 &
  else
    log Info "crond отключён"
  fi
}

box_ownership() {
  # Установить права и владельца каталога ядра
  chown -R "${box_user_group}" "${box_dir}"
  chmod -R 644 "${box_dir}/${bin_name}"

  chown "${box_user_group}" "${bin_path}"
  chmod 6755 "${bin_path}"

  chmod 0700 "${box_dir}/bin/yq"
  chmod 0700 "${box_dir}/bin/curl"
}

box_permission() {
  if [[ "${box_user_group}" == @(root:net_admin|0:3005) && -f "${bin_path}" ]]; then
    # Установить права и владельца каталога ядра
    box_ownership
    log Info "Используется ядро ${bin_path}。"
  else
    if  [[ "${box_user_group}" != @(root:net_admin|0:3005) ]]; then
      log Error "Неподдерживаемая группа пользователей [ \"${box_user_group}\" ]"
      sed -i "s/box_user_group=.*/box_user_group=\"root:net_admin\"/g" "${settings}"
      log Debug "Автоматически переключено на [ root:net_admin ]; перезапустите Box."
      exit 1
    fi
    log Error "Ядро не обнаружено: [ \"${bin_name}\" ]。"
    log Error "Загрузите [ \"${bin_name}\" ] ядро и поместите в \"${bin_dir}/\"."
    log Debug "Выполните в терминале 'su -c \"${scripts_dir}/box.tool upkernel\"' для загрузки ядра"
    set_description error "Ядро не существует"
    exit 1
  fi
}

box_check_bin() {
  if [ ! -x "${bin_path}" ]; then
    log Error "${bin_path} не является исполняемым."
    set_description error "Ядро не является исполняемым"
    exit 1
  fi

  local version_output
  case "${bin_name}" in
    mihomo)
      version_output=$("${bin_path}" -v 2>/dev/null) || {
        log Error "${bin_name} не удалось получить сведения о версии."
        set_description error "Повреждение ядра"
        exit 1
        }
      ;;
    *)
      version_output=$("${bin_path}" version 2>/dev/null) || {
        log Error "${bin_name} не удалось получить сведения о версии."
        set_description error "Повреждение ядра"
        exit 1
        }
      ;;
  esac

  log Info "${version_output}"
}

prepare_singbox() {
  # Проверить файл конфигурации
  if ! [ -f "${sing_config}" ]; then
    log Error "Файл конфигурации не найден: ${sing_config}"
    set_description error "Файл конфигурации не существует"
    exit 1
  else
    log Info "Обнаружена конфигурация: ${sing_config}"
  fi

  # Проверить yq
  yq="yq"
  if ! command -v yq >/dev/null 2>&1; then
    if [ ! -x "${box_dir}/bin/yq" ]; then
      log Debug "yq не найден; начинается загрузка с GitHub"
      "${scripts_dir}/box.tool" upyq
    fi
    yq="${box_dir}/bin/yq"
  fi

  # Установить auto_detect_interface/auto_route
  ${yq} '.route.auto_detect_interface = true' -i --output-format=json "${sing_config}"
  ${yq} '(.inbounds[] | select(.type == "tun") | .auto_route) |= true' -i --output-format=json "${sing_config}"
  
  # Убедиться, что путь к логу является абсолютным
  ${yq} '.log.output = "'"${box_run}/${bin_name}.log"'"' -i --output-format=json "${sing_config}" 2>/dev/null || true

  # Проверить конфигурацию sing-box
  if ( cd "$(dirname "${sing_config}")" && "${bin_path}" check -c "$(basename "${sing_config}")" ) > "${box_run}/${bin_name}.log" 2>&1; then
    # Установить auto_route по network_mode
    if [[ "${network_mode}" == @(mixed|tun) ]]; then
      # Проверить наличие "type": "tun" в конфигурации
      if ! busybox grep -q '"type": "tun"' "${sing_config}"; then
        # Если отсутствует, добавить конфигурацию "tun"
        ${yq} '.inbounds += [{
          "type": "tun",
          "tag": "tun-in",
          "interface_name": "sing",
          "address": ["172.18.0.1/30","fdfe:dcba:9876::1/126"],
          "mtu": 9000,
          "stack": "mixed",
          "auto_route": true,
          "strict_route": true,
          "auto_redirect": true,
          "include_uid": [],
          "exclude_uid": []
        }]' -i --output-format=json "${sing_config}"
        log Debug "Добавлено в ${sing_config} конфигурация [Tun]"
      fi
    else
      # Не tun-режим: отключить auto_route
      # sed -i -e 's/auto_route": true/auto_route": false/g' -e 's/"auto_detect_interface": true/"auto_detect_interface": false/g' "${sing_config}"

      # Проверить наличие конфигурации tproxy
      if ! busybox grep -q '"type": "tproxy"' "${sing_config}"; then
        # Если отсутствует, добавить конфигурацию tproxy
        ${yq} '.inbounds += [{"type": "tproxy", "tag": "tproxy-in", "listen": "::", "listen_port": '"${tproxy_port}"'}]' -i --output-format=json "${sing_config}"
        log Debug "Добавлено в ${sing_config} конфигурация [Tproxy]"
      fi

      # Удалить конфигурацию tun
      ${yq} 'del(.inbounds[] | select(.type == "tun"))' -i --output-format=json "${sing_config}"

      # Синхронизировать порт tproxy
      if busybox grep -q '"type": "tproxy"' "${sing_config}"; then
        ${yq} '(.inbounds[] | select(.type == "tproxy") | .listen_port) = '"${tproxy_port}" -i --output-format=json "${sing_config}"
      fi
    fi

    if [[ "${network_mode}" == @(mixed|tun) ]]; then
      # Режим core: пропустить обработку UID
      if [ "${proxy_mode}" = "core" ]; then
        yq_filter='(.inbounds[] | select(.type == "tun") | .include_uid) = [] |
                   (.inbounds[] | select(.type == "tun") | .exclude_uid) = []'
        "${yq}" eval "$yq_filter" -i --output-format=json "${sing_config}" > /dev/null 2>&1
        log_service_results "sing-box" "core" ""
      else
        # Добавить поле include_uid/exclude_uid для tun
        yq_filter='(.inbounds[] | select(.type == "tun") | .include_uid) = [] |
                   (.inbounds[] | select(.type == "tun") | .exclude_uid) = []'
        
        [[ ${proxy_mode} = "blacklist" || ${proxy_mode} = "black" ]] && mode="exclude" || mode="include"
        
        local uids_to_add=""
        if [ -s "${uid_list}" ]; then
          uids_to_add=$(busybox tr '\n' ',' < "${uid_list}" | sed 's/,$//')
          if [ -n "$uids_to_add" ]; then
            yq_filter="$yq_filter | (.inbounds[] | select(.type == \"tun\") | .${mode}_uid) = [${uids_to_add}]"
          fi
        fi
        "${yq}" eval "$yq_filter" -i --output-format=json "${sing_config}" > /dev/null 2>&1
        log_service_results "sing-box" "$mode" "$uids_to_add"
      fi
    fi

    # Добавить конфигурацию redirect по network_mode
    if [[ "${network_mode}" == @(mixed|enhance|redirect) ]]; then
      if ! busybox grep -q '"type": "redirect"' "${sing_config}"; then
        # Если отсутствует, добавить конфигурацию redirect
        ${yq} '.inbounds += [{
          "type": "redirect",
          "tag": "redirect-in",
          "listen": "::",
          "listen_port": '"${redir_port}"'
        }]' -i --output-format=json "${sing_config}"
        log Debug "Добавлено в ${sing_config} конфигурация [Redirect]"
      fi

      # Синхронизировать порт redir_port
      if busybox grep -q '"type": "redirect"' "${sing_config}"; then
        ${yq} '(.inbounds[] | select(.type == "redirect") | .listen_port) = '"${redir_port}" -i --output-format=json "${sing_config}"
      fi
    fi
  else
    log Error "$(<"${box_run}/${bin_name}.log")"
    log Error "Ошибка конфигурации, проверьте ${box_run}/${bin_name}.log"
    set_description error
    exit 1
  fi
}

prepare_mihomo() {
  # Проверить файл конфигурации
  if ! [ -f "${mihomo_config}" ]; then
    log Error "Файл конфигурации не найден: ${mihomo_config}"
    set_description error "Файл конфигурации не существует"
    exit 1
  else
    log Info "Обнаружена конфигурация: ${mihomo_config}"
  fi

  # Записать external_controller, если не задан
  mihomo_external_controller=$(busybox awk '!/^ *#/ && /external-controller: /{print $1}' "${mihomo_config}")
  if [ -z "${mihomo_external_controller}" ]; then
    printf "\nexternal-controller: 0.0.0.0:9090" >> "${mihomo_config}"
  fi

  # Записать external_ui, если не задан
  mihomo_external_ui=$(busybox awk '!/^ *#/ && /external-ui: /{print $1}' "${mihomo_config}")
  if [ -z "${mihomo_external_ui}" ]; then
    printf "\nexternal-ui: ./dashboard" >> "${mihomo_config}"
  fi

  # Записать tproxy-port, если не задан
  mihomo_tproxy_port=$(busybox awk '!/^ *#/ && /tproxy-port: /{print $1}' "${mihomo_config}")
  if [ -z "${mihomo_tproxy_port}" ]; then
    printf "\ntproxy-port: ${tproxy_port}" >> "${mihomo_config}"
  fi

  # Записать redir-port, если не задан
  mihomo_redir_port=$(busybox awk '!/^ *#/ && /redir-port: /{print $1}' "${mihomo_config}")
  if [ -z "${mihomo_redir_port}" ]; then
    printf "\nredir-port: ${redir_port}" >> "${mihomo_config}"
  fi

  if [[ "${network_mode}" == @(mixed|tun) ]]; then
    mihomo_tun_status=$(busybox awk '!/^ *#/ && /tun:/ { getline; split($0, arr, ": "); print arr[2]; found=1; exit } END{ if (!found) print "" }' "${mihomo_config}" 2>/dev/null)
    # Записать конфигурацию TUN, если не задана
    if [ -z "${mihomo_tun_status}" ]; then
      printf '%s\n' '' 'tun:' \
        '  enable: true' \
        '  mtu: 9000' \
        '  device: meta' \
        '  stack: mixed # / gvisor / system' \
        '  dns-hijack:' \
        '    - any:53' \
        '    - tcp://any:53' \
        '  auto-route: true' \
        '  strict-route: true' \
        '  auto-redirect: true' \
        '  auto-detect-interface: true' \
        '  include-android-user: [0, 10]' \
        '  exclude-uid: []' \
        '  include-uid: []' \ >> "${mihomo_config}"
      log Debug "Добавлено в ${mihomo_config} конфигурация [tun]"
    else
      log Info  "${mihomo_config} уже имеет конфигурацию [tun]"
    fi

    # Режим core: пропустить обработку UID
    if [ "${proxy_mode}" = "core" ]; then
      sed -i -e "s/exclude-uid:.*/exclude-uid: []/g" \
          -e "s/include-uid:.*/include-uid: []/g" \
          -e "/tun:/,/enable:/ { /enable: false/ s/enable: false/enable: true/ }" \
          "${mihomo_config}"
      log_service_results "mihomo" "core" ""
    else
      # Добавить include-uid/exclude-uid для tun
      if [ -f "${uid_list}" ]; then
          list_uid=$(busybox tr '\n' ',' < "${uid_list}" | sed 's/,$//')
      else
          list_uid=""
      fi

      if [[ "${proxy_mode}" = "whitelist" || "${proxy_mode}" = "white" ]]; then
        mode="include"
      elif [[ "${proxy_mode}" = "blacklist" || "${proxy_mode}" = "black" ]]; then
        mode="exclude"
      fi

      # Сбросить список include/exclude_uid и включить tun
      sed -i -e "s/exclude-uid:.*/exclude-uid: []/g" \
          -e "s/include-uid:.*/include-uid: []/g" \
          -e "/tun:/,/enable:/ { /enable: false/ s/enable: false/enable: true/ }" \
          "${mihomo_config}"


      # Проверить наличие include-uid/exclude-uid в блоке tun
      uid_found=$(busybox awk '/^tun:/{f=1} f && /'"$mode-uid:"'/{print $0; exit}' "$mihomo_config")
      if [ -z "$uid_found" ]; then
          sed -i "/^tun:/a \  $mode-uid: []" "$mihomo_config"
      fi

      # Добавить UID в конфигурацию
      if [ -n "${list_uid}" ]; then
        sed -i "s/${mode}-uid:.*/${mode}-uid: [${list_uid}]/g" "${mihomo_config}"
      fi
      log_service_results "mihomo" "$mode" "$list_uid"
    fi

  else
    sed -i "/tun:/,/enable:/ { /enable: true/ s/enable: true/enable: false/ }" "${mihomo_config}"
  fi

  # Синхронизировать порты tproxy/redir
  sed -i -E "s/(tproxy-port: )[0-9]+/\1${tproxy_port}/" "${mihomo_config}"
  sed -i -E "s/(redir-port: )[0-9]+/\1${redir_port}/" "${mihomo_config}"

  mihomo_enhanced_mode=$(busybox awk '!/^ *#/ && /enhanced-mode: / { print $2 }' "${mihomo_config}" 2>/dev/null)
  if [ -z "${mihomo_enhanced_mode}" ]; then
    # Добавить enhanced-mode: fake-ip
    sed -i "/^dns:/a \  enhanced-mode: fake-ip" "$mihomo_config"
    log Debug "Добавлен enhanced-mode: fake-ip"
  fi

  if [[ "${network_mode}" == @(mixed|tproxy|redirect|enhance) ]]; then
    if [[ "${proxy_mode}" != "core" ]] && [[ -n "${packages_list[*]}" || -n "${ignore_ap_list[*]}" || -n "${gid_list[*]}" ]] && [ "${mihomo_enhanced_mode}" = "fake-ip" ]; then
      log Warning "${proxy_mode} работает только в mihomo enhanced-mode: redir-host"
      log Warning "fake-ip заменён на redir-host"
      sed -i "s/enhanced-mode:.*/enhanced-mode: redir-host/g" "${mihomo_config}"
      sed -i "/sniffer:/,/enable:/ { /enable: false/ s/enable: false/enable: true/ }" "${mihomo_config}"
    fi
  fi
}

box_run_bin() {
  log Info "Доступные ядра: [ ${bin_list[*]} ]"
  log Info "Выбранное ядро: ${bin_name}, запуск службы."
  ulimit -SHn 1000000

  # Обновить лог box.tool перед запуском службы
  : > "${box_run}/tool.log"

  case "${bin_name}" in
    hysteria)
      # Синхронизировать порты
      if [ -f "${hysteria_config}" ]; then
        sed -i -e "/tcpTProxy:/,/listen:/s/listen: :.*/listen: :${tproxy_port}/" "${hysteria_config}"
        sed -i -e "/udpTProxy:/,/listen:/s/listen: :.*/listen: :${tproxy_port}/" "${hysteria_config}"
        sed -i -e "/tcpRedirect:/,/listen:/s/listen: :.*/listen: :${redir_port}/" "${hysteria_config}"
      fi

      # Проверить network_mode для hysteria
      case "${network_mode}" in
        redirect|tproxy|enhance)
          # Поддерживаемый режим; действий не требуется
          ;;
        *)
          # Режим не поддерживается; переключение обратно на tproxy
          sed -i 's/\(network_mode=\)"[^\"]*"/\1"tproxy"/g' ${settings}
          ;;
      esac
      nohup busybox setuidgid "${box_user_group}" "${bin_path}" -c "${hysteria_config}" > "${bin_log}" 2>&1 &
      PID=$!
      if kill -0 "${PID}" 2>/dev/null; then
        echo -n "${PID}" > "${box_pid}"
      else
        set_description error
        log Error "$(cat "${box_run}/${bin_name}.log")"
        log Error "Ошибка конфигурации, проверьте ${box_run}/${bin_name}.log"
        exit 1
      fi
      ;;
    sing-box)
      if [ "${auto_modify_config}" = "true" ]; then
        prepare_singbox
      fi
      if ${bin_path} check -c "${sing_config}" -D "${box_dir}/${bin_name}" > "${box_run}/${bin_name}.log" 2>&1; then
        nohup busybox setuidgid "${box_user_group}" "${bin_path}" run -c "${sing_config}" -D "${box_dir}/${bin_name}" > "${bin_log}" 2>&1 &
        PID=$!
        echo -n $PID > "${box_pid}"
      else
        set_description error
        log Error "$(<"${box_run}/${bin_name}.log")"
        log Error "Ошибка конфигурации, проверьте ${box_run}/${bin_name}.log"
        exit 1
      fi
      ;;
    mihomo)
      if [ "${auto_modify_config}" = "true" ]; then
        prepare_mihomo
      fi
      if ${bin_path} -t -d "${box_dir}/${bin_name}" -f "${mihomo_config}" > "${box_run}/${bin_name}.log" 2>&1; then
        nohup busybox setuidgid "${box_user_group}" "${bin_path}" -d "${box_dir}/${bin_name}" -f "${mihomo_config}" > "${bin_log}" 2>&1 &
        PID=$!
        echo -n $PID > "${box_pid}"
      else
        set_description error
        log Error "$(<"${box_run}/${bin_name}.log")"
        log Error "Ошибка конфигурации, проверьте ${box_run}/${bin_name}.log"
        exit 1
      fi
      ;;
    xray)
      if [[ "${network_mode}" != "tproxy" ]]; then
        sed -i 's/\(network_mode=\)"[^\"]*"/\1"tproxy"/g' ${settings}
      fi
      if [ ! -f "${xray_config}" ]; then
        log Error "Файл конфигурации не найден: ${xray_config}"
        set_description error "Файл конфигурации не существует"
        exit 1
      else
        if [[ "${xray_config}" == *.yaml ]]; then
          ${box_dir}/bin/yq '(.inbounds[] | select(.protocol == "dokodemo-door") | .port) = '"${tproxy_port}"'' -i --output-format=yaml "${xray_config}" >/dev/null 2>&1
        elif [[ "${xray_config}" == *.json ]]; then
          ${box_dir}/bin/yq '(.inbounds[] | select(.protocol == "dokodemo-door") | select(.tag == "tproxy-in") | .port) = '"${tproxy_port}" -i --output-format=json "${xray_config}" >/dev/null 2>&1
        fi
        log Info "Найден файл конфигурации: ${xray_config}"
      fi
      export XRAY_LOCATION_ASSET="${box_dir}/${bin_name}"
      if ${bin_path} -test -confdir "${box_dir}/${bin_name}" > "${box_run}/${bin_name}.log" 2>&1; then
        nohup busybox setuidgid "${box_user_group}" "${bin_path}" run -confdir "${box_dir}/${bin_name}" > "${bin_log}" 2>&1 &
        PID=$!
        echo -n $PID > "${box_pid}"
      else
        set_description error
        log Error "$(<"${box_run}/${bin_name}.log")"
        log Error "Ошибка конфигурации, проверьте ${box_run}/${bin_name}.log"
        exit 1
      fi
      ;;
    v2fly)
      if [[ "${network_mode}" != "tproxy" ]]; then
        sed -i 's/\(network_mode=\)"[^"]*"/\1"tproxy"/g' ${settings}
      fi
      if [ ! -f "${v2fly_config}" ]; then
        log Error "Файл конфигурации не найден: ${v2fly_config}"
        set_description error "Файл конфигурации не существует"
        exit 1
      else
        if [[ "${v2fly_config}" == *.yaml ]]; then
          ${box_dir}/bin/yq '(.inbounds[] | select(.protocol == "dokodemo-door") | .port) = '"${tproxy_port}"'' -i --output-format=yaml "${v2fly_config}" >/dev/null 2>&1
        elif [[ "${v2fly_config}" == *.json ]]; then
          ${box_dir}/bin/yq '(.inbounds[] | select(.protocol == "dokodemo-door") | select(.tag == "tproxy-in") | .port) = '"${tproxy_port}" -i --output-format=json "${v2fly_config}" >/dev/null 2>&1
        fi
        log Info "Найден файл конфигурации: ${v2fly_config}"
      fi
      export V2RAY_LOCATION_ASSET="${box_dir}/${bin_name}"
      if ${bin_path} test -d "${box_dir}/${bin_name}" > "${box_run}/${bin_name}.log" 2>&1; then
        nohup busybox setuidgid "${box_user_group}" "${bin_path}" run -d "${box_dir}/${bin_name}" > "${bin_log}" 2>&1 &
        PID=$!
        echo -n $PID > "${box_pid}"
      else
        set_description error
        log Error "$(<"${box_run}/${bin_name}.log")"
        log Error "Ошибка конфигурации, проверьте ${box_run}/${bin_name}.log"
        exit 1
      fi
      ;;
    *)
      log Error "[ ${bin_name} ] Неизвестное ядро."
      exit 1
      ;;
  esac
}

box_cgroup() {
  set_cgroup_config() {
    local cgroup_attr="$1"
    local cgroup_value="$2"

    if [ "${cgroup_value}" = "true" ]; then
      if ${scripts_dir}/box.tool "${cgroup_attr}"; then
        true
      else
        log Warning "Невозможно включить ${bin_name} для ${cgroup_attr}"
        log Warning "Закрыты cgroups ${cgroup_attr}"
        sed -i -E "/cgroup_${cgroup_attr}/ s/(true)/false/" "${settings}"
      fi
    fi
  }
  set_cgroup_config "memcg" "${cgroup_memcg}"
  set_cgroup_config "cpuset" "${cgroup_cpuset}"
  set_cgroup_config "blkio" "${cgroup_blkio}"
}

# Отобразить информацию о состоянии процесса
box_bin_status() {
  # Получить PID процесса
  local PID=$(busybox pidof ${bin_name})

  if [ -z "$PID" ]; then
    log Error "${bin_name} не запущен"
    return 1
  fi

  stack=$(if [ "${bin_name}" != "mihomo" ]; then find "/data/adb/box/sing-box" -type f -name "*.json" -exec busybox awk -F'"' '/"stack"/{print $4}' {} +; else busybox awk '!/^ *#/ && /stack: / { print $2;found=1; exit}' "${mihomo_config}"; fi)
  TOAST=1 log Info "${bin_name} служба работает"

  log Info "Прокси: ${proxy_mode} + Сетевой режим: ${network_mode} + $(if [[ "${network_mode}" == @(mixed|tun) ]]; then echo "Стек: ${stack}"; fi)"

  # Получить информацию об использовании памяти
  rss=$(grep VmRSS /proc/$PID/status | busybox awk '{ print $2 }')
  [ "${rss}" -ge 1024 ] && bin_rss="$(expr ${rss} / 1024) MB" || bin_rss="${rss} KB"
  swap=$(grep VmSwap /proc/$PID/status | busybox awk '{ print $2 }')
  [ "${swap}" -ge 1024 ] && bin_swap="$(expr ${swap} / 1024) MB" || bin_swap="${swap} KB"

  # Получить информацию о группе пользователей
  user_group=$(stat -c %U:%G /proc/$PID)

  # Записать информацию в лог
  log Info "${bin_name} запущен с группой пользователей '${user_group}'"
  log Info "${bin_name} состояние: ${state} (PID: $PID)"
  log Info "${bin_name} память: ${bin_rss}, своп: ${bin_swap}"

  # Получить загрузку ЦП
  cpu=$(ps -p $PID -o %cpu | busybox awk 'NR==2{print $1}' 2>/dev/null)

  cpus_allowed=$(grep Cpus_allowed_list /proc/$PID/status | busybox awk '{ print $2" "$3 }')
  core=$(busybox awk '{print $39}' /proc/$PID/stat 2>/dev/null)

  if [ -n "${cpu}" ]; then
    log Info "${bin_name} загрузка ЦП: ${cpu}%"
  else
    log Info "${bin_name} загрузка ЦП: недоступно"
  fi
  if [ -n "${cpus_allowed}" ]; then
    log Info "${bin_name} разрешённые ядра ЦП: ${cpus_allowed}"
    log Info "${bin_name} процесс $PID последний раз работал на ядре ЦП: ${core}"
  else
    log Info "${bin_name} ядро ЦП: недоступно"
  fi

  # Проверить температуру батареи
  temperature_celsius=$(($(cat /sys/class/power_supply/battery/temp) / 10))
  log Info "Температура батареи: ${temperature_celsius}°C"

  # Получить время работы
  running_time=$(busybox ps -o comm,etime | grep ${bin_name} | busybox awk '{print $2}')
  if [ -n "${running_time}" ]; then
    log Info "${bin_name} время работы: ${running_time}"
  else
    log Info "${bin_name} время работы: недоступно"
  fi
  
  (
    # Локальный IP
    localIP=($(ip -4 a | awk '/inet / && !/127.0.0.1/ { split($2, a, "/"); print a[1] }'))
    log Info "Локальный IP: ${localIP[*]}"
    # Локальный DNS
    localDNS=($(dumpsys connectivity | awk -F'[ ,]' '/DnsAddresses:/ { for (i=1; i<=NF; i++) if ($i ~ /^\/.*$/) { dns=substr($i, 2); if (dns ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print dns } }'))
    log Info "Локальный DNS: ${localDNS[*]}"
  ) &


  # Сохранить ID процесса в pid-файл
  if [ -n "$PID" ]; then
    get_dns_mode
    set_description running
    echo -n "$PID" > "${box_pid}"
  fi
}

set_description() {
  local status="$1"
  local error_msg="$2"
  local desc=""
  local ipv6_info=""
  local wifi_match_str=""
  local ssid_mode_str=""
  local ssid_count=0
  local bssid_count=0

  # Состояние IPv6
  if [ "${ipv6}" = "true" ]; then
    ipv6_info="Включён"
  else
    ipv6_info="Не включён"
  fi

  # Отображается только когда служба запущена, сетевой контроль включён и активно совпадение Wi-Fi (SSID/BSSID)
  if [ "$status" = "running" ] && [ "${enable_network_service_control}" = "true" ] && [ "${use_ssid_matching}" = "true" ]; then
    # Определить режим чёрного/белого списка
    if [ "${use_wifi_list_mode}" = "blacklist" ]; then
      ssid_mode_str="Чёрный список"
    elif [ "${use_wifi_list_mode}" = "whitelist" ]; then
      ssid_mode_str="Белый список"
    else
      ssid_mode_str="Неизвестный режим"
    fi
    ssid_count=0
    for ssid_item in "${wifi_ssids_list[@]}"; do
      [ -n "$ssid_item" ] && ssid_count=$((ssid_count + 1))
    done

    bssid_count=0
    for bssid_item in "${wifi_bssids_list[@]}"; do
      [ -n "$bssid_item" ] && bssid_count=$((bssid_count + 1))
    done

    wifi_match_str=" | Совпадение Wi-Fi (${ssid_mode_str}) SSID:${ssid_count} BSSID:${bssid_count}"
  fi

  case "$status" in
    running)
      desc="✅ Box работает | Ядро: ${bin_name} | Прокси: ${proxy_mode} | Сеть: ${network_mode} | IPv6: ${ipv6_info} | DNS: ${dns_mode}${wifi_match_str}"
      ;;
    stopped)
      desc="❌ Box остановлен | Последнее ядро: ${bin_name} | Прокси отключён"
      ;;
    idle)
      desc="✨ Модуль Box загружен, ожидание запуска службы"
      ;;
    error)
      # Использовать только при ошибке конфигурации
      local current_time
      current_time=$(date "+%Y-%m-%d %H:%M:%S")
      [ -z "${error_msg}" ] && error_msg="Ошибка конфигурации"
      desc="⚠️ Box ${error_msg} | Время: ${current_time} | Ядро: ${bin_name} | Подробности в логе: ${box_run}/${bin_name}.log"
      ;;
    *)
      desc="💤 Состояние Box неизвестно"
      ;;
  esac
  local escaped_desc
  escaped_desc=$(echo "${desc}" | sed -e 's/[&|#]/\\&/g')
  sed -Ei "s#^description=.*#description=${escaped_desc}#g" "$PROPFILE"
}
get_dns_mode() {
  dns_mode="Неизвестно"
  if [ "${bin_name}" = "mihomo" ]; then
    if grep -q "enhanced-mode: redir-host" "${mihomo_config}" 2>/dev/null; then
      dns_mode="redir-host"
    elif grep -q "enhanced-mode: fake-ip" "${mihomo_config}" 2>/dev/null; then
      dns_mode="fake-ip"
    fi
  elif [ "${bin_name}" = "sing-box" ]; then
    if grep -q '"type" *: *"fakeip"' "${sing_config}" 2>/dev/null; then
      dns_mode="fake-ip"
    else
      dns_mode="redir-host"
    fi
  fi
  export dns_mode
}

start_box() {
  find_packages_uid
  get_dns_mode
  set_description running

  echo -n "" > "${box_log}"
  box_version=$(busybox awk '!/^ *#/ && /version=/ { print $0 }' "/data/adb/modules/box_for_root/module.prop" 2>/dev/null)

  if [ -t 1 ]; then
    echo -e "${yellow}$(getprop persist.sys.timezone) $(date)${normal}"
    echo -e "${yellow}$(getprop gsm.sim.operator.alpha) $(getprop gsm.network.type)${normal}"
    echo -e "${yellow}${box_version}($(getprop ro.product.cpu.abi))${normal}"
    echo -e "${white}━━━━━━━━━━━━━━━━━━${normal}"
  else
    {
      echo "$(getprop persist.sys.timezone) $(date)"
      echo "$(getprop gsm.sim.operator.alpha) $(getprop gsm.network.type)"
      echo "${box_version}($(getprop ro.product.cpu.abi))"
      echo "━━━━━━━━━━━━━━━━━━"
    } | tee -a "${box_log}" >/dev/null 2>&1
  fi

  # Обновить iptables, если bin_name ещё запущен
  PIDS=("${bin_list[@]}")
  PID=""
  i=0

  while [ -z "$PID" ] && [ "$i" -lt "${#PIDS[@]}" ]; do
    PID=$(busybox pidof "${PIDS[$i]}")
    i=$((i+1))
  done

  if [ -n "$PID" ]; then
    pid_name="${box_dir}/run/pid_name.txt"
    ps -p $PID -o comm= > "${pid_name}"
    sed -i '/^[[:space:]]*$/d' "${pid_name}"
    log Debug "$(<"${pid_name}")(PID: $PID) служба ещё работает, автоматический перезапуск BOX"
    rm -f "${pid_name}"
    stop_box
    start_box && "${scripts_dir}/box.iptables" renew
    exit 1
  fi

  # Проверить, определён ли bin_name
  case "${bin_name}" in
    mihomo|xray|sing-box|v2fly|hysteria)
      log Info "Запустить службу"
      ;;
    *)
      log Error "bin_name: [ ${bin_name} ] не определён или неизвестен"
      exit 1
      ;;
  esac

  # Проверка busybox
  busybox_code=$(busybox | busybox grep -oE '[0-9.]*' | head -n 1)
  if [ -n "${busybox_code}" ] && [ "$(echo "${busybox_code}" | busybox awk -F. '{printf "%03d%03d%03d\n", $1, $2, $3}')" -lt "$(echo "1.36.1" | busybox awk -F. '{printf "%03d%03d%03d\n", $1, $2, $3}')" ]; then
    log Info "Текущий $(which busybox) v${busybox_code}"
    log Warning "Обновите busybox до v1.36.1+"
  else
    log Info "Текущий $(which busybox) v${busybox_code}"
  fi

  box_permission
  box_check_bin
  box_check_logs

  # Выполнить box_run_crontab, если run_crontab не равен "false"
  [ "${run_crontab}" = "true" ] && box_run_crontab || log Info "Задачи по расписанию отключены"

  if [ -z "${proxy_mode}" ]; then
    M1=$(busybox awk '!/^ *#/ && /mode:/{print $0}' "${pkg_config}")
    [ -z $M1 ] && printf "\nmode:white" >> "${pkg_config}"
    log Debug "Режим прокси пуст, добавление mode:white в ${pkg_config}"
  fi

  # Выполнить функции box_cgroup, box_run_bin, box_detected_port и box_bin_alive
  box_run_bin
  box_cgroup

  count=0
  while [ $count -le 5 ]; do
    box_bin_alive || break
    count=$((count + 1))
  done

  true
}

stop_box() {
  stop_cron
  for bin in "${bin_list[@]}"; do
    if busybox pgrep "${bin}" >/dev/null; then
      if busybox pkill -15 "${bin}" >/dev/null; then
        :
      else
        killall -15 "${bin}" >/dev/null 2>&1 || kill -15 "$(busybox pidof "${bin}")" >/dev/null 2>&1
      fi
    fi
  done

  count=0
  while [ $count -lt 3 ]; do
    if ! busybox pidof "${bin_name}" >/dev/null 2>&1; then
      break
    fi
    sleep 1
    count=$((count + 1))
  done

  if ! busybox pidof "${bin_name}" >/dev/null; then
    if [ -f "${box_pid}" ]; then
      rm -f "${box_pid}"
    fi
    log Warning "${bin_name} остановлен, служба остановлена."
    TOAST=1 log Warning "${bin_name} отключён."
    [ -t 1 ] && echo -e "${white}━━━━━━━━━━━━━━━━━━${normal}"
  else
    log Warning "${bin_name} не полностью остановлен, возможно завершается или не удалось остановить."
    force_stop
  fi

  set_description stopped
}

stop_cron() {
  if ! busybox pkill -f "busybox crond" >/dev/null 2>&1; then
    cronkill=$(busybox pgrep -f "crond -c ${box_run}")
    for cron in ${cronkill}; do
      kill -15 "${cron}" >/dev/null 2>&1
    done
  fi
}

force_stop() {
  log Warning "Попытка принудительного завершения"
  local PID
  PID=$(cat "${box_pid}" 2>/dev/null)

  if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    kill -9 "$PID" >/dev/null 2>&1
  else
    for bin in "${bin_list[@]}"; do
      busybox pkill -9 "${bin}" >/dev/null 2>&1
    done
  fi

  if ! busybox pgrep -f "${bin_name}" >/dev/null 2>&1; then
    log Warning "Готово! Теперь можно отдыхать."
    rm -f "${box_pid}"
  fi
}

# Проверить наличие busybox в системе
if ! command -v busybox &> /dev/null; then
  log Error "$(which busybox) команда не найдена"
  exit 1
fi

case "$1" in
  start)
    stop_box >/dev/null 2>&1
    if start_box; then
        $scripts_dir/box.tool webroot >/dev/null 2>&1
    fi
    ;;
  stop)
    stop_box
    ;;
  restart)
    "${scripts_dir}/box.iptables" disable && stop_box
    if start_box; then
      "${scripts_dir}/box.iptables" renew
      $scripts_dir/box.tool webroot >/dev/null 2>&1
    fi
    ;;
  status)
    # Проверить, запущена ли служба
    if busybox pidof "${bin_name}" >/dev/null; then
      case "${bin_name}" in
        mihomo) echo "${yellow}$("${bin_path}" -v)${normal}";;
        *) echo "${yellow}$("${bin_path}" version)${normal}";;
      esac
      box_bin_status
    else
      log Warning "${bin_name} остановлен, служба остановлена"
    fi
    ;;
  cron)
    run_crontab="true"
    stop_cron
    box_run_crontab
    ;;
  kcron)
    stop_cron
    ;;
  *)
    echo "${red}$0 '$1' не найден${normal}" >&2
    echo "${yellow}Использование${normal}: ${green}$0${normal} {${yellow}start|stop|restart|status|cron|kcron${normal}}" >&2
    ;;
esac