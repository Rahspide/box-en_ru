#!/system/bin/sh

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH:/data/data/com.termux/files/usr/bin"

BASE_DIR="/data/adb/box"
LOG_DIR="${BASE_DIR}/run"
SCRIPTS_DIR="$(dirname "$(realpath "$0")")"
LOG_FILE="${LOG_DIR}/netswitch.log"
STATE_FILE="${BASE_DIR}/run/state/last_check_time"
WIFI_STATE_FILE="${BASE_DIR}/run/state/last_wifi_state"
STABILITY_WINDOW=3

[ "$1" != "w" ] && exit 0
source "${BASE_DIR}/settings.ini"

[ "$enable_network_service_control" != "true" ] && exit 0
source "${SCRIPTS_DIR}/ctr.utils"

mkdir -p "$RUN_DIR"
mkdir -p "${LOG_DIR}" "${BASE_DIR}/run/state" >/dev/null 2>&1 || true

log_msg() {
  [ "$inotify_log_enabled" = "true" ] || return 0
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG_FILE"
}

clean_old_logs() {
  [ -f "$LOG_FILE" ] || return 0
  
  local cutoff=$(date -d '24 hours ago' '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
  [ -n "$cutoff" ] || return 0
  
  busybox awk -v c="$cutoff" '!/^[0-9]{4}-/ || substr($0,1,19)>=c' "$LOG_FILE" > "${LOG_FILE}.tmp" && 
    mv "${LOG_FILE}.tmp" "$LOG_FILE"
}

check_stability_window() {
  local current=$(date +%s)
  local last=0
  
  [ -f "$STATE_FILE" ] && last=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
  
  if [ $((current - last)) -lt $STABILITY_WINDOW ]; then
    log_msg "Пропуск: в пределах окна стабилизации ($((current - last))с)"
    exit 0
  fi
  
  echo "$current" > "$STATE_FILE"
}

is_service_running() {
  [ -f "$box_pid" ] && kill -0 $(cat "$box_pid" 2>/dev/null) 2>/dev/null
}

start_service() {
  if is_service_running; then
    log_msg "[Пропуск] Сервис уже запущен"
    return 0
  fi
  
  "${SCRIPTS_DIR}/box.service" start
  "${SCRIPTS_DIR}/box.iptables" enable
  log_msg "[Запуск] Сервис запущен"
}

stop_service() {
  if ! is_service_running; then
    log_msg "[Пропуск] Сервис уже остановлен"
    return 0
  fi
  
  "${SCRIPTS_DIR}/box.iptables" disable
  "${SCRIPTS_DIR}/box.service" stop
  log_msg "[Стоп] Сервис остановлен"
}

save_wifi_state() {
  local ssid="$1"
  local bssid="$2"
  local ip="$3"
  
  cat > "$WIFI_STATE_FILE" <<-EOF
	ssid:${ssid}
	bssid:${bssid}
	ip:${ip}
	EOF
}

main() {
  clean_old_logs
  check_stability_window
  
  local wifi_status=$(is_wifi_connected)
  local ssid=$(get_current_ssid)
  local bssid=$(get_current_bssid)
  local wifi_ip
  
  log_msg "--- Проверка состояния сети ---"
  
  if [ "$wifi_status" = "wifi" ]; then
    # Ожидание IP-адреса
    for i in 1 2 3; do
      wifi_ip=$(get_wifi_ip)
      [ -n "$wifi_ip" ] && break
      sleep 1
    done
    
    if [ -z "$wifi_ip" ]; then
      log_msg "WiFi подключается, ожидание IP-адреса"
      exit 0
    fi
    
    log_msg "WiFi: ${ssid}, BSSID: ${bssid}, IP: ${wifi_ip}"
    save_wifi_state "$ssid" "$bssid" "$wifi_ip"
  else
    log_msg "WiFi: отключён"
  fi
  
  # Определить, нужно ли включить сервис
  if should_enable_service "$wifi_status" "$ssid" "$bssid"; then
    log_msg "Политика: включить сервис"
    start_service
  else
    log_msg "Политика: отключить сервис"
    stop_service
  fi
  
  log_msg "Готово"
}

main